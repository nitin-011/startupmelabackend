# Startup Mela Backend — environment variables
#
# Copy to .env and fill in real values. Never commit .env.
# For Vercel: set these in Project → Settings → Environment Variables.

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
# "production" selects the PHONEPE_PROD_* credentials and the live gateway;
# anything else uses PHONEPE_DEV_* against the PhonePe sandbox.
#
# REQUIRED. If unset the server assumes production rather than development,
# so that an unset variable can never quietly enable the test payment routes.
# That means local development must set this explicitly.
NODE_ENV=development

# Enables POST /api/payment/test and the TEST-prefixed order short circuit,
# both of which issue confirmed tickets with NO payment. Local development
# only: it is ignored when NODE_ENV=production and ignored on any deployed
# host, so it cannot be switched on in a live environment by accident.
ENABLE_TEST_PAYMENTS=false

# ── Database ─────────────────────────────────────────────────────────────
MONGO_URI=

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=
# Required in the X-Admin-Create-Secret header to call POST /api/admin/create.
ADMIN_CREATE_SECRET=

# ── PhonePe — merchant credentials ───────────────────────────────────────
PHONEPE_PROD_MERCHANT_ID=
PHONEPE_PROD_SALT_KEY=
PHONEPE_PROD_SALT_INDEX=1

PHONEPE_DEV_MERCHANT_ID=
PHONEPE_DEV_SALT_KEY=
PHONEPE_DEV_SALT_INDEX=1

# ── Email (SMTP) ─────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── URLs ─────────────────────────────────────────────────────────────────
# FRONTEND_URL builds the post-payment redirect, so it must point at the
# deployed site in production or customers return to the wrong host.
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ── Cloudinary (student stall document uploads) ──────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── One-time migration ───────────────────────────────────────────────────
# After deploying, run once per environment:
#
#   node scripts/updatePendingTicketTTL.js
#
# MongoDB will not change expireAfterSeconds on an index that already
# exists, so the PendingTicket TTL stays at the old 15 minutes until this
# runs. Confirmation happens only when the customer's browser returns from
# the gateway, so that window is the whole margin for error: a customer who
# takes longer than it loses their booking with no way to recover it.
