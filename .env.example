# Startup Mela Backend — environment variables
#
# Copy to .env and fill in real values. Never commit .env.
# For Vercel: set these in Project → Settings → Environment Variables.

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
# "production" selects the PHONEPE_PROD_* credentials and the live gateway.
# Anything else uses PHONEPE_DEV_* against the PhonePe sandbox, and enables
# the /api/payment/test endpoint and the TEST-prefixed order short circuit.
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────
MONGO_URI=

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=
# Required in the X-Admin-Create-Secret header to call POST /api/admin/create.
ADMIN_CREATE_SECRET=

# ── PhonePe — merchant credentials ───────────────────────────────────────
PHONEPE_PROD_MERCHANT_ID=
PHONEPE_PROD_SALT_KEY=
PHONEPE_PROD_SALT_INDEX=1

PHONEPE_DEV_MERCHANT_ID=
PHONEPE_DEV_SALT_KEY=
PHONEPE_DEV_SALT_INDEX=1

# ── PhonePe — webhook callback (REQUIRED for reliable confirmation) ───────
#
# Payment confirmation must not depend on the customer's browser returning
# from the gateway. If they close the tab, the only things that can still
# issue their ticket are the webhook and the reconcile sweep below.
#
# Set these to the same username/password pair configured against the
# callback URL in the PhonePe merchant dashboard:
#
#   Callback URL:  <BACKEND_URL>/api/payment/webhook
#
# Until both the dashboard entry and these two values exist, the webhook
# endpoint returns 500 and confirmation falls back to browser polling plus
# the reconcile sweep.
PHONEPE_CALLBACK_USERNAME=
PHONEPE_CALLBACK_PASSWORD=

# ── Reconciliation sweep ─────────────────────────────────────────────────
#
# Backstop for orders missed by both the redirect and the webhook. Any
# strong random string; the scheduled job sends it as:
#
#   Authorization: Bearer <CRON_SECRET>
#
# Scheduled in vercel.json (every 10 minutes). NOTE: sub-daily crons require
# a Vercel Pro plan — on Hobby, change the schedule to daily or remove the
# "crons" block and trigger POST /api/payment/reconcile some other way.
#
# This path needs NO PhonePe dashboard access — it reuses the merchant
# credentials above — so it can be enabled independently of the webhook.
CRON_SECRET=

# ── Email (SMTP) ─────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── URLs ─────────────────────────────────────────────────────────────────
# FRONTEND_URL builds the post-payment redirect, so it must point at the
# deployed site in production or customers return to the wrong host.
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ── Cloudinary (student stall document uploads) ──────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── One-time migration ───────────────────────────────────────────────────
# After deploying, run once per environment:
#
#   node scripts/updatePendingTicketTTL.js
#
# MongoDB will not change expireAfterSeconds on an index that already
# exists, so the PendingTicket TTL stays at the old 15 minutes until this
# runs — which would expire paid-but-unconfirmed orders before the webhook
# or reconcile sweep can recover them.
